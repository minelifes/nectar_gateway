[Unit]
Description=Nectar Gateway reverse proxy
After=network.target
# never give up restarting, even after repeated crashes
StartLimitIntervalSec=0

[Service]
User=nectar
Group=nectar
WorkingDirectory=/opt/nectar_gateway
ExecStart=/opt/nectar_gateway/nectar_gateway
Restart=always
RestartSec=3
# graceful shutdown: SIGTERM, then up to 35s for in-flight requests
TimeoutStopSec=35
LimitNOFILE=1048576
# Go runtime: plenty for a proxy; a low limit prevents the kernel
# OOM killer from targeting the gateway when backends eat the RAM
Environment=GOMEMLIMIT=4GiB
Environment=GOGC=200
Environment=PROXY_ADDR=:80
Environment=HTTPS_ADDR=:443
Environment=ADMIN_ADDR=:8081
Environment=DB_PATH=/opt/nectar_gateway/nectar.db
# Set real credentials here:
Environment=ADMIN_USER=admin
Environment=ADMIN_PASS=change-me
# Let's Encrypt (certbot must be installed; see README for sudoers rule)
Environment=CERTBOT_BIN="sudo -n certbot"
Environment=CERTBOT_WEBROOT=/var/www/certbot
Environment=CERTBOT_EMAIL=you@example.com
# push notifications for backend health (ntfy.sh topic or compatible webhook)
# Environment=NOTIFY_URL=https://ntfy.sh/your-secret-topic-name
# allow binding to ports 80/443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
